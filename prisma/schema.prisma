model UserProfilePicture {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
  isCurrent Boolean  @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([userId, isCurrent])
}
enum EventNotificationType {
  join
  leave
  late
  confirmed
  declined
  status_change
  comment
  event_updated
  event_cancelled
}

enum GroupNotificationType {
  accepted
  invited
  join_request
  event_created
  nearby_created
}

enum TeamUpNotificationType {
  teamup_response
  teamup_accepted
  teamup_declined
  teamup_nearby
}
enum EventParticipantStatus {
  pending
  confirmed
  declined
}

enum GuestParticipantStatus {
  confirmed
  declined
}
model GroupMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model EventReminder {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  remindAt  DateTime
  sent      Boolean  @default(false)

  @@unique([eventId, userId, remindAt]) // Composite key for multiple reminders per event/user
  @@index([sent]) // For efficient querying of sent reminders
}

model EventAttendance {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("on-time") // on-time, late
  updatedAt DateTime @updatedAt
  
  @@unique([eventId, userId])
}

model EventNotification {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      EventNotificationType
  params    Json?    // Parameters for frontend translation (e.g., { name, eventTitle })
  metadata  Json?    // Additional data for the notification
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([eventId]) // For event notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
}

model GroupNotification {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      GroupNotificationType
  params    Json?    // Parameters for frontend translation (e.g., { groupName })
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([groupId]) // For group notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
}

model TeamUpNotification {
  id              String   @id @default(uuid())
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            TeamUpNotificationType
  params          Json?    // Parameters for frontend translation (e.g., { name, title, sportType })
  metadata        Json?    // Additional data for the notification
  createdAt       DateTime @default(now())
  read            Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([teamUpRequestId]) // For teamup request notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note: In Prisma v7, the database URL is configured in prisma.config.ts
// instead of here. See prisma.config.ts for the datasource configuration.
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // OAuth fields
  googleId    String?  @unique
  facebookId  String?  @unique
  authProvider String? // 'local', 'google', 'facebook'
  oauthProfilePicture String? // Profile picture URL from OAuth provider
  lastOAuthSync DateTime? // Last time OAuth data was synced
  
  // Two-Factor Authentication fields
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorBackupCodes String[] @default([])

  // Email notification fields
  emailNotifications Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  emailVerificationToken String?
  
  // Password reset fields
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Security: Failed login attempts tracking
  failedLoginAttempts Int      @default(0)
  accountLockedUntil  DateTime?
  
  // Location fields
  city              String?
  country           String?
  address           String?
  postalCode        String?
  discoveryRadius   Int?     @default(25) // km - default radius for location-based discovery
  
  // Profile picture
  profilePicture    String?
  profilePictures   UserProfilePicture[]
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  groupMemberships  GroupMember[]
  createdGroups     Group[]             @relation("GroupCreator")
  createdEvents     Event[]             @relation("EventCreator")
  eventParticipants EventParticipant[]  @relation("EventParticipant")
  groupMessages     GroupMessage[]
  eventReminders    EventReminder[]
  eventAttendances  EventAttendance[]
  eventNotifications EventNotification[]
  groupNotifications GroupNotification[]
  teamUpNotifications TeamUpNotification[]
  groupJoinRequests GroupJoinRequest[]
  createdEventRequests EventRequest[]   @relation("EventRequestCreator")
  eventVotes        EventVote[]
  emailPreferences  EmailPreference?
  comments          Comment[]
  commentMentions   CommentMention[]
  refreshTokens     RefreshToken[]
  revokedTokens     RevokedToken[]
  activeSessions    UserSession[]
  teamUpRequests    TeamUpRequest[]  @relation("TeamUpRequestCreator")
  teamUpResponses   TeamUpResponse[]
  teamUpComments    TeamUpComment[]
  tournaments       Tournament[]     @relation("TournamentOrganizer")
  captainedTeams    TournamentTeam[] @relation("TeamCaptain")
  tournamentPlayers TournamentPlayer[] @relation("TournamentPlayer")
  receivedTeamInvitations TournamentTeamInvitation[] @relation("TeamInvitations")
  sentTeamInvitations     TournamentTeamInvitation[] @relation("SentTeamInvitations")
  
  @@index([email]) // For faster email lookups
  @@index([emailVerificationToken]) // For email verification
  @@index([passwordResetToken]) // For password reset lookups
  @@index([city, country]) // For location-based queries
  @@index([createdAt, deletedAt]) // Example composite index for queries
  @@index([googleId]) // For OAuth lookups
  @@index([facebookId]) // For OAuth lookups
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  
  // Group picture
  picture     String?

  creatorId String
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id])

  members GroupMember[]
  events  Event[]
  joinRequests GroupJoinRequest[]
  groupMessages GroupMessage[]
  groupNotifications GroupNotification[]
  eventRequests EventRequest[]
  tournaments Tournament[]
}

model GroupJoinRequest {
  id        String   @id @default(uuid())
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  status    String  @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
}

model GroupMember {
  id        String   @id @default(uuid())
  role      String   @default("member") // member, moderator, admin
  joinedAt  DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId]) // For user's groups queries
  @@index([groupId]) // For group members queries
  @@index([role]) // For admin/moderator/member filtering
  @@index([groupId, role]) // Composite index for efficient role-based queries within a group (scalability)
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum SportType {
  football
  basketball
  tennis
  volleyball
  running
  cycling
  swimming
  cricket
  americanFootball
  iceHockey
  baseball
  rugby
  handball
  fieldHockey
  other
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   SportType
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  startTime   DateTime
  endTime     DateTime?
  maxPlayers  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archived    Boolean  @default(false) // For archiving past events
  status      EventStatus   @default(upcoming)

  // Public/Private event and invite features
  isPublic    Boolean  @default(false) // Public events can be joined by anyone with the link
  inviteToken String?  @unique // Unique token for shareable invite links

  // Recurring event fields
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // RRULE format: "FREQ=WEEKLY;BYDAY=SU"
  recurrenceEnd   DateTime?
  parentEventId   String?
  parentEvent     Event?    @relation("RecurringEvents", fields: [parentEventId], references: [id], onDelete: Cascade)
  instances       Event[]   @relation("RecurringEvents")
  exceptionDates  Json?     // Array of dates to skip
  // If exceptionDates grows large, consider a separate EventException table for better performance

  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  participants EventParticipant[]
  guestParticipants GuestParticipant[]
  eventReminders EventReminder[]
  eventAttendances EventAttendance[]
  eventNotifications EventNotification[]
  comments Comment[]

  @@index([groupId]) // For group events queries
  @@index([creatorId]) // For user's created events
  @@index([startTime]) // For date-based queries
  @@index([status]) // For status filtering
  @@index([eventType]) // For type filtering
  @@index([inviteToken]) // For invite link lookups
  @@index([archived]) // For archived events filtering
  @@index([groupId, startTime]) // Composite for group events by date
  @@index([creatorId, startTime]) // Composite for user events by date
  @@index([city, country]) // For location-based queries
  @@index([status, startTime]) // Composite for filtering by status and date (scalability)
  @@index([eventType, startTime]) // Composite for filtering by event type and date (scalability)
  @@index([isPublic, startTime]) // Composite for public event discovery (scalability)
  @@index([archived, status, startTime]) // Composite for active event queries (scalability)
  // If archived events grow large, consider partitioning or archiving to a separate table for performance
}

model EventParticipant {
  id         String   @id @default(uuid())
  status     EventParticipantStatus @default(pending)
  joinedAt   DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("EventParticipant", fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId]) // For event participants queries
  @@index([userId]) // For user's events queries
  @@index([status]) // For filtering by status
  @@index([eventId, status]) // Composite for event participants by status
  @@index([joinedAt]) // For joined date queries
}

model EventRequest {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   String
  location    String?
  startTime   DateTime
  endTime     DateTime?
  maxPlayers  Int?
  createdAt   DateTime @default(now())
  status      String   @default("voting") // voting, finalized, cancelled, expired
  voteDeadline DateTime? // When voting closes
  voteThreshold Float?   @default(0.5) // % of votes needed (0.5 = 50%)
  
  creatorId   String
  creator     User     @relation("EventRequestCreator", fields: [creatorId], references: [id])
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  votes       EventVote[]
  finalizedEventId String?  @unique
}

model EventVote {
  id        String   @id @default(uuid())
  vote      String   // yes, no
  createdAt DateTime @default(now())
  
  eventRequestId String
  eventRequest   EventRequest @relation(fields: [eventRequestId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([eventRequestId, userId])
}

model EmailPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventInvites    Boolean  @default(true)
  eventReminders  Boolean  @default(true)
  eventUpdates    Boolean  @default(true)
  eventCancellations Boolean @default(true)
  groupInvites    Boolean  @default(true)
  commentMentions Boolean  @default(true)
  nearbyTeamUps   Boolean  @default(true)

  muteEventInvites    Boolean  @default(false)
  muteEventReminders  Boolean  @default(false)
  muteEventUpdates    Boolean  @default(false)
  muteEventCancellations Boolean @default(false)
  muteGroupInvites    Boolean  @default(false)
  muteGroupRequests   Boolean  @default(false)
  muteNearbyGroups    Boolean  @default(false)
  muteEventCreated    Boolean  @default(false)
  muteNearbyTeamUps   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  mentions  CommentMention[]
}

model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([commentId, userId])
}

model GuestParticipant {
  id         String   @id @default(uuid())
  name       String   // Guest's display name
  status     GuestParticipantStatus @default(confirmed)
  joinedAt   DateTime @default(now())
  
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId])
  @@index([joinedAt]) // For joined date queries
}

// JWT Refresh Token for token rotation
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// Revoked JWT tokens (blacklist)
model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime @default(now())
  expiresAt DateTime // Keep until token would naturally expire
  reason    String?  // logout, password_change, security, etc.
  
  @@index([token])
  @@index([userId])
  @@index([expiresAt]) // For cleanup of expired entries
}

// Active user sessions for session management
model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique // JWT token hash
  deviceInfo String?  // User agent, device type
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Email notification queue for reliable delivery
model EmailQueue {
  id          String   @id @default(uuid())
  recipient   String
  subject     String
  htmlContent String
  textContent String?
  templateType String? // eventInvitation, eventUpdate, etc.
  templateData Json?   // Data for template rendering
  status      String   @default("pending") // pending, sent, failed, retry
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  createdAt   DateTime @default(now())
  scheduledAt DateTime @default(now())
  sentAt      DateTime?
  
  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
}

// TeamUp functionality for finding substitute/replacement players
model TeamUpRequest {
  id          String   @id @default(uuid())
  title       String
  description String?
  sportType   String   // e.g., "football", "basketball", "tennis", etc.
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  dateTime    DateTime // When the sub/replacement is needed
  playersNeeded Int    @default(1) // Number of players needed
  skillLevel  String?  // beginner, intermediate, advanced, any
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("open") // open, filled, cancelled, expired
  expiresAt   DateTime? // Auto-expire after a certain time
  
  creatorId   String
  creator     User     @relation("TeamUpRequestCreator", fields: [creatorId], references: [id])
  
  responses      TeamUpResponse[]
  notifications  TeamUpNotification[]
  comments       TeamUpComment[]
  
  @@index([creatorId])
  @@index([dateTime])
  @@index([status])
  @@index([sportType])
  @@index([city, country])
  @@index([status, dateTime]) // For finding open requests by date
  @@index([sportType, status, dateTime]) // Composite for sport type filtering with status and date (scalability)
  @@index([city, country, status, dateTime]) // Composite for location-based queries with status (scalability)
  @@index([creatorId, status]) // Composite for user's requests by status (scalability)
}

// Responses to TeamUp requests (people interested in filling the spots)
model TeamUpResponse {
  id        String   @id @default(uuid())
  message   String?  // Optional message from the responder
  status    String   @default("pending") // pending, accepted, declined
  createdAt DateTime @default(now())
  
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  @@unique([teamUpRequestId, userId])
  @@index([teamUpRequestId])
  @@index([userId])
  @@index([status])
  @@index([userId, teamUpRequestId]) // Composite index for permission checks (scalability)
}

// Comments/Chat for TeamUp requests
model TeamUpComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  @@index([teamUpRequestId])
  @@index([userId])
  @@index([createdAt])
}

// Tournament hosting functionality
enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
  groups_knockout
}

enum TournamentStatus {
  draft
  registration
  in_progress
  completed
  cancelled
}

enum MatchStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum BracketStage {
  group_stage
  round_of_32
  round_of_16
  quarter_finals
  semi_finals
  third_place
  finals
}

model Tournament {
  id          String   @id @default(uuid())
  name        String
  description String?
  sportType   SportType
  format      TournamentFormat @default(single_elimination)
  status      TournamentStatus @default(draft)
  startDate   DateTime
  endDate     DateTime?
  maxTeams    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Location fields
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  
  // Organizer
  organizerId String
  organizer   User     @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  
  // Optional group association
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  // Admin controls
  registrationDeadline DateTime?
  isPublic            Boolean  @default(true)
  allowLateRegistration Boolean @default(false)
  autoGenerateBrackets Boolean @default(false)
  useManualBrackets   Boolean  @default(false) // Enable manual bracket/pool management
  prizesDescription   String?
  rulesDescription    String?
  contactEmail        String?
  
  // Recurring tournament support
  isRecurring         Boolean  @default(false)
  recurrenceRule      String?  // RRule format
  parentTournamentId  String?
  parentTournament    Tournament? @relation("RecurringTournaments", fields: [parentTournamentId], references: [id], onDelete: SetNull)
  childTournaments    Tournament[] @relation("RecurringTournaments")
  
  teams       TournamentTeam[]
  matches     TournamentMatch[]
  standings   TournamentStanding[]
  pools       TournamentPool[]
  
  @@index([organizerId])
  @@index([groupId])
  @@index([status])
  @@index([startDate])
  @@index([sportType])
  @@index([city, country])
  @@index([isPublic])
  @@index([parentTournamentId])
}

model TournamentTeam {
  id           String   @id @default(uuid())
  name         String
  captainName  String?
  captainEmail String?
  captainUserId String?
  captainUser   User?   @relation("TeamCaptain", fields: [captainUserId], references: [id])
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  // Manual pool/bracket management (legacy - use poolId for new implementations)
  poolNumber   Int?     // For manual pool assignment (1, 2, 3, etc.) - legacy field
  poolName     String?  // Custom pool name (e.g., "Pool A", "Group 1")
  seedNumber   Int?     // Seeding position for bracket generation
  
  // Pool registration (new implementation)
  poolId       String?
  pool         TournamentPool? @relation("PoolTeams", fields: [poolId], references: [id], onDelete: SetNull)
  registrationOrder Int? // Order in which team registered to pool
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  homeMatches  TournamentMatch[] @relation("HomeTeam")
  awayMatches  TournamentMatch[] @relation("AwayTeam")
  refereingMatches TournamentMatch[] @relation("RefereeTeam")
  standings    TournamentStanding[]
  players      TournamentPlayer[]
  waitlistEntries TournamentPoolWaitlist[]
  invitations  TournamentTeamInvitation[]
  
  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([captainUserId])
  @@index([poolNumber])
  @@index([poolId])
  @@index([tournamentId, captainUserId]) // Composite index for permission checks (scalability)
}

model TournamentMatch {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  homeTeamId   String
  homeTeam     TournamentTeam @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId   String
  awayTeam     TournamentTeam @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  
  // Referee assignment - team that will officiate this match
  refereeTeamId String?
  refereeTeam   TournamentTeam? @relation("RefereeTeam", fields: [refereeTeamId], references: [id], onDelete: SetNull)
  
  homeScore    Int?
  awayScore    Int?
  
  // Detailed scoring for sports with sets/periods (e.g., volleyball, tennis)
  // Format: { sets: [{home: 25, away: 23}, {home: 23, away: 25}], ... }
  detailedScore Json?
  
  stage        BracketStage?
  roundNumber  Int?      // For round-robin or group stages
  groupName    String?   // For group stages (e.g., "Group A")
  
  // Manual bracket management
  isManuallyCreated Boolean @default(false) // Track if match was manually created
  matchOrder   Int?      // Custom ordering for display
  
  status       MatchStatus @default(scheduled)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([tournamentId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeTeamId])
  @@index([status])
  @@index([stage])
  @@index([matchOrder])
}

model TournamentStanding {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  teamId       String
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  points       Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  
  groupName    String?  // For group stages
  
  updatedAt    DateTime @updatedAt
  
  @@unique([tournamentId, teamId, groupName])
  @@index([tournamentId])
  @@index([teamId])
  @@index([points])
}

// Tournament players - tracks registered players on a team
model TournamentPlayer {
  id        String   @id @default(uuid())
  
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?    @relation("TournamentPlayer", fields: [userId], references: [id], onDelete: SetNull)
  
  playerName  String   // Name of the player (required even if userId is set)
  playerEmail String?  // Optional email
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([teamId, userId]) // A user can only be registered once per team
  @@index([teamId])
  @@index([userId])
  @@index([userId, teamId]) // Composite index for permission checks (scalability)
}

// Tournament pools - separate pools within a tournament with different team capacities
model TournamentPool {
  id           String   @id @default(uuid())
  name         String   // Pool name (e.g., "Pool A", "Beginners Pool", "Advanced Pool")
  description  String?
  maxTeams     Int      // Maximum number of teams allowed in this pool
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  teams        TournamentTeam[] @relation("PoolTeams")
  waitlist     TournamentPoolWaitlist[]
  
  @@unique([tournamentId, name])
  @@index([tournamentId])
}

// Tournament pool waitlist - teams waiting for a spot in a full pool
model TournamentPoolWaitlist {
  id        String   @id @default(uuid())
  
  poolId    String
  pool      TournamentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  position  Int      // Position in the waitlist (lower = higher priority)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([poolId, teamId])
  @@index([poolId])
  @@index([teamId])
  @@index([poolId, position])
}

// Tournament team invitations - captains can invite players to join their team
enum InvitationStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

model TournamentTeamInvitation {
  id        String   @id @default(uuid())
  
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  // Email of the person being invited (they may or may not have an account)
  inviteeEmail String
  inviteeName  String?  // Optional: name of the invitee
  
  // If the invitee has an account, link to their user
  inviteeUserId String?
  inviteeUser   User?    @relation("TeamInvitations", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  
  // Who sent the invitation
  inviterId String
  inviter   User     @relation("SentTeamInvitations", fields: [inviterId], references: [id])
  
  // Unique invitation token for secure acceptance
  inviteToken String   @unique
  
  status      InvitationStatus @default(pending)
  
  // Message from the inviter
  message     String?
  
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([teamId])
  @@index([inviteeEmail])
  @@index([inviteeUserId])
  @@index([inviteToken])
  @@index([status])
  @@index([expiresAt])
  @@index([teamId, inviteeEmail, status])
}
