model GroupMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model EventReminder {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  remindAt  DateTime
  sent      Boolean  @default(false)
}

model EventAttendance {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("on-time") // on-time, late
  updatedAt DateTime @updatedAt
  
  @@unique([eventId, userId])
}

model EventNotification {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // join, leave, late
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model GroupNotification {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // accepted, invited
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note: In Prisma v7, the database URL is configured in prisma.config.ts
// instead of here. See prisma.config.ts for the datasource configuration.
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Two-Factor Authentication fields
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorBackupCodes String[] @default([])

  // Email notification fields
  emailNotifications Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  emailVerificationToken String?
  
  // Location fields
  city              String?
  country           String?

  groupMemberships  GroupMember[]
  createdGroups     Group[]             @relation("GroupCreator")
  createdEvents     Event[]             @relation("EventCreator")
  eventParticipants EventParticipant[]  @relation("EventParticipant")
  groupMessages     GroupMessage[]
  eventReminders    EventReminder[]
  eventAttendances  EventAttendance[]
  eventNotifications EventNotification[]
  groupNotifications GroupNotification[]
  groupJoinRequests GroupJoinRequest[]
  createdEventRequests EventRequest[]   @relation("EventRequestCreator")
  eventVotes        EventVote[]
  emailPreferences  EmailPreference?
  comments          Comment[]
  commentMentions   CommentMention[]
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?

  creatorId String
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id])

  members GroupMember[]
  events  Event[]
  joinRequests GroupJoinRequest[]
  groupMessages GroupMessage[]
  groupNotifications GroupNotification[]
  eventRequests EventRequest[]
}

model GroupJoinRequest {
  id        String   @id @default(uuid())
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  status    String  @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
}

model GroupMember {
  id        String   @id @default(uuid())
  role      String   @default("member") // member, admin
  joinedAt  DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   String   // e.g., "football", "basketball", "tennis", etc.
  location    String?
  startTime   DateTime
  endTime     DateTime?
  maxPlayers  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Recurring event fields
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // RRULE format: "FREQ=WEEKLY;BYDAY=SU"
  recurrenceEnd   DateTime?
  parentEventId   String?
  parentEvent     Event?    @relation("RecurringEvents", fields: [parentEventId], references: [id], onDelete: Cascade)
  instances       Event[]   @relation("RecurringEvents")
  exceptionDates  Json?     // Array of dates to skip

  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  participants EventParticipant[]
  eventReminders EventReminder[]
  eventAttendances EventAttendance[]
  eventNotifications EventNotification[]
  comments Comment[]
}

model EventParticipant {
  id         String   @id @default(uuid())
  status     String   @default("pending") // pending, confirmed, declined
  joinedAt   DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("EventParticipant", fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model EventRequest {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   String
  location    String?
  startTime   DateTime
  endTime     DateTime?
  maxPlayers  Int?
  createdAt   DateTime @default(now())
  status      String   @default("voting") // voting, finalized, cancelled
  
  creatorId   String
  creator     User     @relation("EventRequestCreator", fields: [creatorId], references: [id])
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  votes       EventVote[]
  finalizedEventId String?  @unique
}

model EventVote {
  id        String   @id @default(uuid())
  vote      String   // yes, no
  createdAt DateTime @default(now())
  
  eventRequestId String
  eventRequest   EventRequest @relation(fields: [eventRequestId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([eventRequestId, userId])
}

model EmailPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventInvites    Boolean  @default(true)
  eventReminders  Boolean  @default(true)
  eventUpdates    Boolean  @default(true)
  eventCancellations Boolean @default(true)
  groupInvites    Boolean  @default(true)
  commentMentions Boolean  @default(true)

  muteEventInvites    Boolean  @default(false)
  muteEventReminders  Boolean  @default(false)
  muteEventUpdates    Boolean  @default(false)
  muteEventCancellations Boolean @default(false)
  muteGroupInvites    Boolean  @default(false)
  muteGroupRequests   Boolean  @default(false)
  muteNearbyGroups    Boolean  @default(false)
  muteEventCreated    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  mentions  CommentMention[]
}

model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([commentId, userId])
}
