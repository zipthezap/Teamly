model UserProfilePicture {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
  isCurrent Boolean  @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([userId, isCurrent])
}
enum SessionNotificationType {
  join
  leave
  late
  confirmed
  declined
  status_change
  comment
  session_updated
  session_cancelled
}

enum GroupNotificationType {
  accepted
  invited
  join_request
  session_created
  nearby_created
  removed
}

enum TeamUpNotificationType {
  teamup_response
  teamup_accepted
  teamup_declined
  teamup_nearby
  teamup_comment
}

enum TournamentNotificationType {
  team_registered
  team_invited
  tournament_updated
  tournament_cancelled
  match_scheduled
  score_submitted
  payment_reminder
  score_disputed
  announcement
}

enum PushDevicePlatform {
  android
  ios
  web
}
enum SessionParticipantStatus {
  pending
  confirmed
  declined
  waitlisted
  co_organizer
}

enum GuestParticipantStatus {
  confirmed
  declined
}

enum GroupJoinRequestSource {
  USER      // User-initiated join request
  INVITE    // Admin/moderator invitation
  LINK      // Joined via invite link
}

enum GroupJoinRequestStatus {
  pending
  approved
  rejected
}

enum GroupMemberRole {
  member
  moderator
  admin
}

model GroupMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model SessionReminder {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  remindAt  DateTime
  sent      Boolean  @default(false)

  @@unique([sessionId, userId, remindAt]) // Composite key for multiple reminders per session/user
  @@index([sent]) // For efficient querying of sent reminders
}

enum SessionAttendanceStatus {
  on_time
  late
}

model SessionAttendance {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    SessionAttendanceStatus   @default(on_time)
  updatedAt DateTime @updatedAt
  
  @@unique([sessionId, userId])
  @@index([status]) // For filtering by attendance status
}

model SessionNotification {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      SessionNotificationType
  params    Json?    // Parameters for frontend translation (e.g., { name, sessionTitle })
  metadata  Json?    // Additional data for the notification
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([sessionId]) // For session notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
  @@index([userId, createdAt, id]) // Composite for efficient cursor-based pagination
  @@index([userId, read, createdAt]) // Composite for unread + sorted queries
}

model GroupNotification {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      GroupNotificationType
  params    Json?    // Parameters for frontend translation (e.g., { groupName })
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([groupId]) // For group notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
  @@index([userId, createdAt, id]) // Composite for efficient cursor-based pagination
  @@index([userId, read, createdAt]) // Composite for unread + sorted queries
}

model TeamUpNotification {
  id              String   @id @default(uuid())
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            TeamUpNotificationType
  params          Json?    // Parameters for frontend translation (e.g., { name, title, sportType })
  metadata        Json?    // Additional data for the notification
  createdAt       DateTime @default(now())
  read            Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([teamUpRequestId]) // For teamup request notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
  @@index([userId, createdAt, id]) // Composite for efficient cursor-based pagination
  @@index([userId, read, createdAt]) // Composite for unread + sorted queries
}

model TournamentNotification {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         TournamentNotificationType
  params       Json?    // Parameters for frontend translation (e.g., { tournamentName, teamName })
  metadata     Json?    // Additional data for the notification
  createdAt    DateTime @default(now())
  read         Boolean  @default(false)
  
  @@index([userId]) // For user notifications queries
  @@index([tournamentId]) // For tournament notifications
  @@index([read]) // For unread filtering
  @@index([userId, read]) // Composite for unread user notifications
  @@index([createdAt]) // For chronological sorting
  @@index([userId, createdAt, id]) // Composite for efficient cursor-based pagination
  @@index([userId, read, createdAt]) // Composite for unread + sorted queries
}

// Invite audit log for tracking all invitation activity
model InviteLog {
  id          String   @id @default(uuid())
  inviterType String   // "group" or "event"
  entityId    String   // groupId or eventId
  inviterId   String   // User who sent the invite
  inviter     User     @relation("InviteLogInviter", fields: [inviterId], references: [id])
  inviteeEmail String  // Email of invited user
  inviteeId   String?  // User ID if registered
  invitee     User?    @relation("InviteLogInvitee", fields: [inviteeId], references: [id])
  status      String   // "sent", "accepted", "declined", "expired", "revoked"
  sentAt      DateTime @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  revoker     User?    @relation("InviteLogRevoker", fields: [revokedBy], references: [id])
  message     String?  // Optional custom message with the invite
  metadata    Json?    // Additional data
  
  @@index([inviterType, entityId]) // For finding all invites for a group/event
  @@index([inviterId]) // For finding all invites sent by a user
  @@index([inviteeEmail]) // For finding invites by email
  @@index([status]) // For filtering by status
  @@index([sentAt]) // For chronological queries
  @@index([expiresAt]) // For cleanup of expired invites
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note: In Prisma v7, the database URL is configured in prisma.config.ts
// instead of here. See prisma.config.ts for the datasource configuration.
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // OAuth fields
  googleId    String?  @unique
  facebookId  String?  @unique
  appleId     String?  @unique
  authProvider String? // 'local', 'google', 'facebook', 'apple'
  oauthProfilePicture String? // Profile picture URL from OAuth provider
  lastOAuthSync DateTime? // Last time OAuth data was synced
  
  // Two-Factor Authentication fields
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorBackupCodes String[] @default([])

  // Email notification fields
  emailNotifications Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  emailVerificationToken String?
  
  // Password reset fields
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Security: Failed login attempts tracking
  failedLoginAttempts Int      @default(0)
  accountLockedUntil  DateTime?
  
  // Location fields
  city              String?
  country           String?
  address           String?
  postalCode        String?
  discoveryRadius   Int?     @default(25) // km - default radius for location-based discovery
  
  // Profile picture
  profilePicture    String?
  profilePictures   UserProfilePicture[]
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?

  groupMemberships  GroupMember[]
  createdGroups     Group[]             @relation("GroupCreator")
  createdSessions      Session[]            @relation("SessionCreator")
  sessionParticipants  SessionParticipant[] @relation("SessionParticipant")
  groupMessages     GroupMessage[]
  sessionReminders     SessionReminder[]
  sessionAttendances   SessionAttendance[]
  sessionNotifications SessionNotification[]
  groupNotifications GroupNotification[]
  teamUpNotifications TeamUpNotification[]
  tournamentNotifications TournamentNotification[]
  groupJoinRequests GroupJoinRequest[]
  invitedGroupJoinRequests GroupJoinRequest[] @relation("GroupInviter")
  sentInvites       InviteLog[]      @relation("InviteLogInviter")
  receivedInvites   InviteLog[]      @relation("InviteLogInvitee")
  revokedInvites    InviteLog[]      @relation("InviteLogRevoker")
  createdSessionRequests SessionRequest[]  @relation("SessionRequestCreator")
  sessionVotes         SessionVote[]
  emailPreferences  EmailPreference?
  comments          Comment[]
  commentMentions   CommentMention[]
  refreshTokens     RefreshToken[]
  revokedTokens     RevokedToken[]
  activeSessions    UserSession[]
  teamUpRequests    TeamUpRequest[]  @relation("TeamUpRequestCreator")
  teamUpResponses   TeamUpResponse[]
  teamUpComments    TeamUpComment[]
  teamUpModerationReports TeamUpModerationCase[] @relation("TeamUpModerationReporter")
  teamUpModerationAssignments TeamUpModerationCase[] @relation("TeamUpModerationAssignee")
  teamUpSavedSearches TeamUpSavedSearch[]
  teamUpRequestViews TeamUpRequestView[]
  tournaments       Tournament[]     @relation("TournamentOrganizer")
  captainedTeams    TournamentTeam[] @relation("TeamCaptain")
  tournamentPlayers TournamentPlayer[] @relation("TournamentPlayer")
  receivedTeamInvitations TournamentTeamInvitation[] @relation("TeamInvitations")
  sentTeamInvitations     TournamentTeamInvitation[] @relation("SentTeamInvitations")
  tournamentAdminRoles    TournamentAdminRole[] @relation("TournamentAdminRoles")
  grantedAdminRoles       TournamentAdminRole[] @relation("TournamentAdminRolesGranted")
  disputeResolutions      TournamentScoreDispute[] @relation("DisputeResolver")
  tournamentAnnouncements TournamentAnnouncement[] @relation("TournamentAnnouncementAuthor")
  scorekeeperMatches      TournamentMatch[]        @relation("MatchScorekeeper")
  resolvedIncidents       TournamentMatchIncident[] @relation("IncidentResolver")
  groupBans         GroupBan[]
  issuedGroupBans   GroupBan[]       @relation("GroupBanner")
  auditLogs         AuditLog[]
  pushDeviceTokens  PushDeviceToken[]
  organizedLeagues      League[]     @relation("LeagueOrganizer")
  captainedLeagueTeams  LeagueTeam[] @relation("LeagueTeamCaptain")
  leaguePlayers         LeaguePlayer[] @relation("LeaguePlayer")
  
  @@index([email]) // For faster email lookups
  @@index([emailVerificationToken]) // For email verification
  @@index([passwordResetToken]) // For password reset lookups
  @@index([city, country]) // For location-based queries
  @@index([createdAt, deletedAt]) // Example composite index for queries
  @@index([googleId]) // For OAuth lookups
  @@index([facebookId]) // For OAuth lookups
  @@index([appleId]) // For Apple OAuth lookups
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  
  // Group picture
  picture     String?

  // Enhanced group settings
  sportType   SportType? // Primary sport type for the group
  maxMembers  Int?       // Maximum number of members (null = unlimited)
  autoApproveJoinRequests Boolean @default(false) // Auto-approve join requests for public groups
  tags        String?    // Comma-separated tags/interests (e.g., "competitive,weekend-warriors,beginners-welcome")
  allowMemberInvites Boolean @default(false) // Allow non-admin members to invite others to the group
  allowMemberCopyLink Boolean @default(true) // Allow non-admin members to copy the group invite link
  
  // Invite token for shareable group links (similar to events)
  inviteToken String? @unique // Unique token for invite links
  inviteTokenExpiresAt DateTime? // Optional expiration for invite tokens

  creatorId String
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id])

  members GroupMember[]
  sessions  Session[]
  joinRequests GroupJoinRequest[]
  groupMessages GroupMessage[]
  groupNotifications GroupNotification[]
  sessionRequests SessionRequest[]
  tournaments Tournament[]
  leagues League[]
  groupBans   GroupBan[]
}

model GroupJoinRequest {
  id        String   @id @default(uuid())
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  status    GroupJoinRequestStatus  @default(pending)
  createdAt DateTime @default(now())
  createdBy GroupJoinRequestSource @default(USER) // Source of the join request
  expiresAt DateTime? // Optional expiration for invites
  invitedBy String?   // ID of user who sent the invite
  inviter   User?     @relation("GroupInviter", fields: [invitedBy], references: [id])
  
  @@index([status]) // For filtering by status
  @@index([userId, status]) // For user's pending requests
  @@index([expiresAt]) // For cleaning up expired invites
}

model GroupMember {
  id        String   @id @default(uuid())
  role      GroupMemberRole   @default(member)
  joinedAt  DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId]) // For user's groups queries
  @@index([groupId]) // For group members queries
  @@index([role]) // For admin/moderator/member filtering
  @@index([groupId, role]) // Composite index for efficient role-based queries within a group (scalability)
}

// Banned users - prevents rejoining after removal
model GroupBan {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bannedBy  String   // userId of admin/moderator who banned
  banner    User     @relation("GroupBanner", fields: [bannedBy], references: [id])
  reason    String?
  bannedAt  DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

// Generic audit log for admin actions
model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // 'group' | 'event' | 'tournament'
  entityId   String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // 'member_removed' | 'role_changed' | 'join_request_approved' | etc.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum SessionStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum SportType {
  football
  basketball
  tennis
  volleyball
  running
  cycling
  swimming
  cricket
  americanFootball
  iceHockey
  baseball
  rugby
  handball
  fieldHockey
  other
}

model Session {
  id          String   @id @default(uuid())
  title       String
  description String?
  sessionType SportType
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  startTime   DateTime
  endTime     DateTime?
  maxPlayers  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archived    Boolean  @default(false) // For archiving past sessions
  status      SessionStatus   @default(upcoming)

  // Public/Private session and invite features
  isPublic    Boolean  @default(false) // Public sessions can be joined by anyone with the link
  inviteToken String?  @unique // Unique token for shareable invite links
  inviteTokenExpiresAt DateTime? // Optional expiration for session invite tokens

  // Recurring session fields
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // RRULE format: "FREQ=WEEKLY;BYDAY=SU"
  recurrenceEnd   DateTime?
  parentSessionId String?
  parentSession   Session?  @relation("RecurringSessions", fields: [parentSessionId], references: [id], onDelete: Cascade)
  instances       Session[] @relation("RecurringSessions")
  exceptionDates  Json?     // Array of dates to skip
  // If exceptionDates grows large, consider a separate SessionException table for better performance

  creatorId String
  creator   User   @relation("SessionCreator", fields: [creatorId], references: [id])
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  participants SessionParticipant[]
  guestParticipants GuestParticipant[]
  sessionReminders SessionReminder[]
  sessionAttendances SessionAttendance[]
  sessionNotifications SessionNotification[]
  comments Comment[]
  leagueEntries LeagueSessionEntry[] @relation("LeagueSessions")

  @@index([groupId]) // For group sessions queries
  @@index([creatorId]) // For user's created sessions
  @@index([startTime]) // For date-based queries
  @@index([status]) // For status filtering
  @@index([sessionType]) // For type filtering
  @@index([inviteToken]) // For invite link lookups
  @@index([archived]) // For archived sessions filtering
  @@index([groupId, startTime]) // Composite for group sessions by date
  @@index([creatorId, startTime]) // Composite for user sessions by date
  @@index([city, country]) // For location-based queries
  @@index([status, startTime]) // Composite for filtering by status and date (scalability)
  @@index([sessionType, startTime]) // Composite for filtering by session type and date (scalability)
  @@index([isPublic, startTime]) // Composite for public session discovery (scalability)
  @@index([archived, status, startTime]) // Composite for active session queries (scalability)
  // If archived sessions grow large, consider partitioning or archiving to a separate table for performance
}

model SessionParticipant {
  id         String   @id @default(uuid())
  status     SessionParticipantStatus @default(pending)
  joinedAt   DateTime @default(now())

  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("SessionParticipant", fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId]) // For session participants queries
  @@index([userId]) // For user's sessions queries
  @@index([status]) // For filtering by status
  @@index([sessionId, status]) // Composite for session participants by status
  @@index([joinedAt]) // For joined date queries
}

enum SessionRequestStatus {
  voting
  finalized
  cancelled
  expired
}

model SessionRequest {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventType   String
  location    String?
  startTime   DateTime
  endTime     DateTime?
  maxPlayers  Int?
  createdAt   DateTime @default(now())
  status      SessionRequestStatus   @default(voting)
  voteDeadline DateTime? // When voting closes
  voteThreshold Float?   @default(0.5) // % of votes needed (0.5 = 50%)
  
  creatorId   String
  creator     User     @relation("SessionRequestCreator", fields: [creatorId], references: [id])
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  votes       SessionVote[]
  finalizedSessionId String?  @unique
}

model SessionVote {
  id        String   @id @default(uuid())
  vote      String   // yes, no
  createdAt DateTime @default(now())
  
  sessionRequestId String
  sessionRequest   SessionRequest @relation(fields: [sessionRequestId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([sessionRequestId, userId])
}

model EmailPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionInvites    Boolean  @default(true)
  sessionReminders  Boolean  @default(true)
  sessionUpdates    Boolean  @default(true)
  sessionCancellations Boolean @default(true)
  groupInvites    Boolean  @default(true)
  commentMentions Boolean  @default(true)
  nearbyTeamUps   Boolean  @default(true)

  muteSessionInvites    Boolean  @default(false)
  muteSessionReminders  Boolean  @default(false)
  muteSessionUpdates    Boolean  @default(false)
  muteSessionCancellations Boolean @default(false)
  muteGroupInvites    Boolean  @default(false)
  muteGroupRequests   Boolean  @default(false)
  muteNearbyGroups    Boolean  @default(false)
  muteSessionCreated  Boolean  @default(false)
  muteNearbyTeamUps   Boolean  @default(false)
  pushEnabled         Boolean  @default(true)
  pushSessions        Boolean  @default(true)
  pushGroups          Boolean  @default(true)
  pushTeamUp          Boolean  @default(true)
  pushTournaments     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PushDeviceToken {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  PushDevicePlatform
  token     String             @unique
  enabled   Boolean            @default(true)
  locale    String?
  timezone  String?
  appVersion String?
  deviceModel String?
  lastSeen  DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, enabled])
  @@index([lastSeen])
  @@index([platform])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  
  mentions  CommentMention[]
}

model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([commentId, userId])
}

model GuestParticipant {
  id         String   @id @default(uuid())
  name       String   // Guest's display name
  status     GuestParticipantStatus @default(confirmed)
  joinedAt   DateTime @default(now())
  
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId])
  @@index([joinedAt]) // For joined date queries
}

// JWT Refresh Token for token rotation
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// Revoked JWT tokens (blacklist)
model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime @default(now())
  expiresAt DateTime // Keep until token would naturally expire
  reason    String?  // logout, password_change, security, etc.
  
  @@index([token])
  @@index([userId])
  @@index([expiresAt]) // For cleanup of expired entries
}

// Active user sessions for session management
model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique // JWT token hash
  deviceInfo String?  // User agent, device type
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

enum EmailQueueStatus {
  pending
  sent
  failed
  retry
}

// Email notification queue for reliable delivery
model EmailQueue {
  id          String   @id @default(uuid())
  recipient   String
  subject     String
  htmlContent String
  textContent String?
  templateType String? // eventInvitation, eventUpdate, etc.
  templateData Json?   // Data for template rendering
  status      EmailQueueStatus   @default(pending)
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  createdAt   DateTime @default(now())
  scheduledAt DateTime @default(now())
  sentAt      DateTime?
  
  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
}

enum TeamUpRequestType {
  need_players
  looking_for_play
}

enum TeamUpRequestStatus {
  open
  filled
  cancelled
  expired
}

enum TeamUpResponseStatus {
  pending
  accepted
  declined
  cancelled
  waitlisted
}

enum TeamUpRsvpStatus {
  unset
  going
  late
  cant_make_it
}

enum TeamUpAttendanceStatus {
  attended
  late
  no_show
  excused
}

// TeamUp functionality for finding substitute/replacement players
model TeamUpRequest {
  id          String   @id @default(uuid())
  title       String
  description String?
  sportType   String   // e.g., "football", "basketball", "tennis", etc.
  requestType TeamUpRequestType @default(need_players) // need_players or looking_for_play
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  dateTime    DateTime // When the session is / the user is available from
  playersNeeded Int    @default(1) // Number of players needed
  skillLevel  String?  // beginner, intermediate, advanced, any
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      TeamUpRequestStatus   @default(open)
  expiresAt   DateTime? // Auto-expire after a certain time
  
  creatorId   String
  creator     User     @relation("TeamUpRequestCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  
  positions      TeamUpRequestPosition[]
  responses      TeamUpResponse[]
  notifications  TeamUpNotification[]
  comments       TeamUpComment[]
  moderationCases TeamUpModerationCase[]
  views          TeamUpRequestView[]
  
  @@index([creatorId])
  @@index([dateTime])
  @@index([status])
  @@index([sportType])
  @@index([requestType])
  @@index([city, country])
  @@index([latitude, longitude])
  @@index([status, dateTime]) // For finding open requests by date
  @@index([sportType, status, dateTime]) // Composite for sport type filtering with status and date (scalability)
  @@index([requestType, status, dateTime]) // Composite for request type filtering with status (scalability)
  @@index([city, country, status, dateTime]) // Composite for location-based queries with status (scalability)
  @@index([creatorId, status]) // Composite for user's requests by status (scalability)
}

// Position/role requirements for TeamUp requests (e.g. goalkeeper, striker)
model TeamUpRequestPosition {
  id        String   @id @default(uuid())
  name      String
  slotsNeeded Int    @default(1)
  skillLevelRequired String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)

  responses TeamUpResponse[]

  @@index([teamUpRequestId])
  @@index([teamUpRequestId, name])
  @@index([teamUpRequestId, slotsNeeded])
}

// Responses to TeamUp requests (people interested in filling the spots)
model TeamUpResponse {
  id        String   @id @default(uuid())
  message   String?  // Optional message from the responder
  applicantSkillLevel String?
  status    TeamUpResponseStatus   @default(pending)
  rsvpStatus TeamUpRsvpStatus @default(unset)
  rsvpUpdatedAt DateTime?
  attendanceStatus TeamUpAttendanceStatus?
  attendanceMarkedAt DateTime?
  attendanceMarkedByUserId String?
  waitlistRank Int?
  autoFillOfferedAt DateTime?
  autoFillExpiresAt DateTime?
  matchScore Float?
  matchReasons Json?
  createdAt DateTime @default(now())
  
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  requestPositionId String?
  requestPosition   TeamUpRequestPosition? @relation(fields: [requestPositionId], references: [id], onDelete: SetNull)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  @@unique([teamUpRequestId, userId])
  @@index([teamUpRequestId])
  @@index([requestPositionId])
  @@index([userId])
  @@index([status])
  @@index([userId, teamUpRequestId]) // Composite index for permission checks (scalability)
  @@index([teamUpRequestId, status, requestPositionId])
  @@index([teamUpRequestId, requestPositionId, waitlistRank])
  @@index([userId, attendanceStatus])
}

// Comments/Chat for TeamUp requests
model TeamUpComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  @@index([teamUpRequestId])
  @@index([userId])
  @@index([createdAt])
}

enum TeamUpModerationStatus {
  open
  in_review
  resolved
  dismissed
}

model TeamUpModerationCase {
  id              String   @id @default(uuid())
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  reporterId      String
  reporter        User     @relation("TeamUpModerationReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?    @relation("TeamUpModerationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reason          String
  status          TeamUpModerationStatus @default(open)
  resolutionNote  String?
  decisionAt      DateTime?
  decidedByUserId String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamUpRequestId, status])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model TeamUpSavedSearch {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  sportType         String?
  requestType       TeamUpRequestType?
  skillLevel        String?
  city              String?
  country           String?
  search            String?
  fromDate          DateTime?
  toDate            DateTime?
  preferredPosition String?
  preferredSkillLevel String?
  notifyOnMatch     Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}

model TeamUpRequestView {
  id              String   @id @default(uuid())
  teamUpRequestId String
  teamUpRequest   TeamUpRequest @relation(fields: [teamUpRequestId], references: [id], onDelete: Cascade)
  viewerId        String?
  viewer          User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  source          String?  // browse | nearby | notification | deep_link
  viewedAt        DateTime @default(now())

  @@index([teamUpRequestId, viewedAt])
  @@index([viewerId, viewedAt])
}

// Tournament hosting functionality
enum TournamentFormat {
  single_elimination
  double_elimination
  round_robin
  groups_knockout
}

enum TournamentStatus {
  draft
  registration
  registration_closed
  in_progress
  completed
  cancelled
}

enum MatchStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum BracketStage {
  group_stage
  round_of_32
  round_of_16
  quarter_finals
  semi_finals
  third_place
  finals
}

model Tournament {
  id          String   @id @default(uuid())
  name        String
  description String?
  sportType   SportType
  format      TournamentFormat @default(single_elimination)
  status      TournamentStatus @default(draft)
  startDate   DateTime
  endDate     DateTime?
  maxTeams    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Location fields
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  
  // Organizer
  organizerId String
  organizer   User     @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  
  // Optional group association
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  // Admin controls
  registrationStartDate DateTime? // Registration opens on this date
  registrationDeadline DateTime?
  isPublic            Boolean  @default(true)
  allowLateRegistration Boolean @default(false)
  autoGenerateBrackets Boolean @default(false)
  useManualBrackets   Boolean  @default(false) // Enable manual bracket/pool management
  prizesDescription   String?
  rulesDescription    String?
  contactEmail        String?
  
  // Sport-specific scoring configuration
  sportConfig         Json?    // JSON field for sport-specific scoring rules

  // Registration fee / payment
  registrationFee           Float?   // Fee per team (in local currency). null = free
  requirePaymentForBrackets Boolean  @default(false) // Block bracket generation until all teams are marked paid
  paymentInfo               String?  // Payment instructions for teams (e.g. how/where to transfer the fee)
  requireWaiverForRegistration Boolean @default(false) // Require waiver acceptance before team registration
  waiverText                 String?  // Organizer-provided waiver terms

  // New gap-feature fields
  rosterLockDate   DateTime?  // Date after which roster changes are locked (#10)
  paymentDeadline  DateTime?  // Deadline for team payment (#15)
  tiebreakerRules  Json?      // Array of tiebreaker rule keys e.g. ["goal_difference","goals_for"] (#6)

  // Public portal (Phase 4)
  shareToken       String?   @unique  // Opaque token for shareable/embeddable public URL

  // Recurring tournament support
  isRecurring         Boolean  @default(false)
  recurrenceRule      String?  // RRule format
  parentTournamentId  String?
  parentTournament    Tournament? @relation("RecurringTournaments", fields: [parentTournamentId], references: [id], onDelete: SetNull)
  childTournaments    Tournament[] @relation("RecurringTournaments")
  
  teams       TournamentTeam[]
  matches     TournamentMatch[]
  standings   TournamentStanding[]
  pools       TournamentPool[]
  categories  TournamentCategory[]
  adminRoles  TournamentAdminRole[]
  notifications TournamentNotification[]
  registrationWaitlist TournamentRegistrationWaitlist[]
  announcements        TournamentAnnouncement[]
  registrationFields   TournamentRegistrationField[]
  paymentTransactions  TournamentPaymentTransaction[]
  courts               TournamentCourt[]
  incidents            TournamentMatchIncident[]
  
  @@index([organizerId])
  @@index([groupId])
  @@index([status])
  @@index([startDate])
  @@index([sportType])
  @@index([city, country])
  @@index([isPublic])
  @@index([parentTournamentId])
  @@index([shareToken])
}

model TournamentTeam {
  id           String   @id @default(uuid())
  name         String
  captainName  String?
  captainEmail String?
  captainUserId String?
  captainUser   User?   @relation("TeamCaptain", fields: [captainUserId], references: [id])
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  // Manual pool/bracket management (legacy - use poolId for new implementations)
  poolNumber   Int?     // For manual pool assignment (1, 2, 3, etc.) - legacy field
  poolName     String?  // Custom pool name (e.g., "Pool A", "Group 1")
  seedNumber   Int?     // Seeding position for bracket generation
  
  // Pool registration (new implementation)
  poolId       String?
  pool         TournamentPool? @relation("PoolTeams", fields: [poolId], references: [id], onDelete: SetNull)
  registrationOrder Int? // Order in which team registered to pool

  // Payment tracking (for tournaments with registrationFee > 0)
  paymentStatus String   @default("unpaid") // unpaid | pending | paid | waived
  paidAt        DateTime?
  paidByUserId  String?  // admin who marked the payment
  waiverAcceptedAt DateTime?
  waiverAcceptedByUserId String?

  // New gap-feature fields
  checkedIn    Boolean  @default(false)  // Day-of check-in (#4)
  checkedInAt  DateTime?                 // When they checked in (#4)
  checkInToken String?  @unique          // QR-scannable check-in token (Phase 3)
  logoUrl      String?                   // Team logo URL (#13)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  homeMatches  TournamentMatch[] @relation("HomeTeam")
  awayMatches  TournamentMatch[] @relation("AwayTeam")
  refereingMatches TournamentMatch[] @relation("RefereeTeam")
  standings    TournamentStanding[]
  players      TournamentPlayer[]
  waitlistEntries TournamentPoolWaitlist[]
  invitations  TournamentTeamInvitation[]
  registrationWaitlist TournamentRegistrationWaitlist[]
  teamAnswers          TournamentTeamAnswer[]
  playerStats          TournamentPlayerStat[]
  scoreDisputes        TournamentScoreDispute[]
  paymentTransactions  TournamentPaymentTransaction[]
  
  @@unique([tournamentId, name])
  @@unique([tournamentId, captainUserId])
  @@index([tournamentId])
  @@index([captainUserId])
  @@index([poolNumber])
  @@index([poolId])
  @@index([tournamentId, captainUserId]) // Composite index for permission checks (scalability)
}

model TournamentMatch {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  homeTeamId   String
  homeTeam     TournamentTeam @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId   String
  awayTeam     TournamentTeam @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  
  // Referee assignment - team that will officiate this match
  refereeTeamId String?
  refereeTeam   TournamentTeam? @relation("RefereeTeam", fields: [refereeTeamId], references: [id], onDelete: SetNull)

  // Scorekeeper assignment - individual user responsible for live score entry (Phase 3)
  scorekeeperUserId String?
  scorekeeper       User?   @relation("MatchScorekeeper", fields: [scorekeeperUserId], references: [id], onDelete: SetNull)
  
  homeScore    Int?
  awayScore    Int?
  
  // Detailed scoring for sports with sets/periods (e.g., volleyball, tennis)
  // Format: { sets: [{home: 25, away: 23}, {home: 23, away: 25}], ... }
  detailedScore Json?
  
  stage        BracketStage?
  roundNumber  Int?      // For round-robin or group stages
  groupName    String?   // For group stages (e.g., "Group A")
  
  // Manual bracket management
  isManuallyCreated Boolean @default(false) // Track if match was manually created
  matchOrder   Int?      // Custom ordering for display
  
  status       MatchStatus @default(scheduled)
  scheduledAt  DateTime?
  scheduledDurationMinutes Int? @default(60)
  courtId      String?
  court        TournamentCourt? @relation(fields: [courtId], references: [id], onDelete: SetNull)
  location     String?
  startedAt    DateTime?
  completedAt  DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([tournamentId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeTeamId])
  @@index([scorekeeperUserId])
  @@index([status])
  @@index([stage])
  @@index([matchOrder])
  @@index([courtId])
  @@index([courtId, scheduledAt])
  disputes  TournamentScoreDispute[]
  incidents TournamentMatchIncident[]
}

enum TournamentPaymentTransactionStatus {
  initiated
  pending
  paid
  failed
  refunded
  cancelled
}

model TournamentPaymentTransaction {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUserId String
  provider     String   @default("manual")
  providerReference String?
  amount       Float
  currency     String   @default("USD")
  status       TournamentPaymentTransactionStatus @default(initiated)
  metadata     Json?
  paidAt       DateTime?
  refundedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tournamentId])
  @@index([teamId])
  @@index([status])
  @@index([providerReference])
}

model TournamentCourt {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  location     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches      TournamentMatch[]
  availabilities TournamentCourtAvailability[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

model TournamentCourtAvailability {
  id         String   @id @default(uuid())
  courtId    String
  court      TournamentCourt @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek  Int?
  date       DateTime?
  startTime  String
  endTime    String
  isBlocked  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courtId])
  @@index([date])
  @@index([dayOfWeek])
}

model TournamentStanding {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  teamId       String
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  points       Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  
  groupName    String?  // For group stages
  
  updatedAt    DateTime @updatedAt
  
  @@unique([tournamentId, teamId, groupName])
  @@index([tournamentId])
  @@index([teamId])
  @@index([points])
}

// Tournament players - tracks registered players on a team
model TournamentPlayer {
  id        String   @id @default(uuid())
  
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?    @relation("TournamentPlayer", fields: [userId], references: [id], onDelete: SetNull)
  
  playerName  String   // Name of the player (required even if userId is set)
  playerEmail String?  // Optional email
  jerseyNumber Int?     // Jersey number (#11)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([teamId, userId]) // A user can only be registered once per team
  @@index([teamId])
  @@index([userId])
  @@index([userId, teamId]) // Composite index for permission checks (scalability)
  stats TournamentPlayerStat[]
}

// Tournament pools - separate pools within a tournament with different team capacities
model TournamentPool {
  id           String   @id @default(uuid())
  name         String   // Pool name (e.g., "Pool A", "Beginners Pool", "Advanced Pool")
  description  String?
  venue        String?  // Physical location / gym for this pool (e.g., "Gym A", "Court 3")
  maxTeams     Int      // Maximum number of teams allowed in this pool
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  // Optional category association
  categoryId   String?
  category     TournamentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  teams        TournamentTeam[] @relation("PoolTeams")
  waitlist     TournamentPoolWaitlist[]
  
  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([categoryId])
}

// Tournament pool waitlist - teams waiting for a spot in a full pool
model TournamentPoolWaitlist {
  id        String   @id @default(uuid())
  
  poolId    String
  pool      TournamentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  position  Int      // Position in the waitlist (lower = higher priority)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([poolId, teamId])
  @@index([poolId])
  @@index([teamId])
  @@index([poolId, position])
}

// Tournament-level registration waitlist (#2)
model TournamentRegistrationWaitlist {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@index([teamId])
  @@index([tournamentId, position])
}

// Score dispute (#3)
enum ScoreDisputeStatus {
  open
  resolved
  dismissed
}

model TournamentScoreDispute {
  id              String   @id @default(uuid())
  matchId         String
  match           TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  disputingTeamId String
  disputingTeam   TournamentTeam @relation(fields: [disputingTeamId], references: [id], onDelete: Cascade)
  reason          String
  status          ScoreDisputeStatus @default(open)
  resolution      String?
  resolvedById    String?
  resolvedBy      User?    @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([matchId, disputingTeamId])
  @@index([matchId])
  @@index([disputingTeamId])
  @@index([status])
}

// Tournament announcement (#7)
model TournamentAnnouncement {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("TournamentAnnouncementAuthor", fields: [authorId], references: [id])
  title        String
  body         String
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([tournamentId])
  @@index([tournamentId, createdAt])
}

// Custom registration questions (#9)
enum RegistrationFieldType {
  text
  number
  boolean
  select
}

model TournamentRegistrationField {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  label        String
  fieldType    RegistrationFieldType @default(text)
  isRequired   Boolean  @default(false)
  options      Json?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  answers      TournamentTeamAnswer[]
  @@index([tournamentId])
  @@index([tournamentId, sortOrder])
}

model TournamentTeamAnswer {
  id        String   @id @default(uuid())
  fieldId   String
  field     TournamentRegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([fieldId, teamId])
  @@index([fieldId])
  @@index([teamId])
}

// Player stats per tournament (#12)
model TournamentPlayerStat {
  id           String   @id @default(uuid())
  tournamentId String
  teamId       String
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId     String
  player       TournamentPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  statKey      String
  value        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([playerId, statKey])
  @@index([tournamentId])
  @@index([teamId])
  @@index([playerId])
}

// Game-day incident tracking with SLA (Phase 3)
enum MatchIncidentType {
  late_start
  injury
  dispute
  technical
  other
}

enum MatchIncidentStatus {
  open
  resolved
  dismissed
}

model TournamentMatchIncident {
  id              String              @id @default(uuid())
  tournamentId    String
  tournament      Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId         String
  match           TournamentMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reportedByUserId String
  incidentType    MatchIncidentType   @default(other)
  description     String
  status          MatchIncidentStatus @default(open)
  slaDeadline     DateTime?           // When the incident must be resolved by
  resolvedById    String?
  resolvedBy      User?               @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tournamentId])
  @@index([matchId])
  @@index([status])
  @@index([slaDeadline])
}

// Tournament categories - ranking tiers (e.g. "Elite", "Intermediate", "Beginner")
model TournamentCategory {
  id           String   @id @default(uuid())
  name         String   // Category name (e.g., "Elite", "Intermediate", "Beginner")
  description  String?
  sortOrder    Int      @default(0) // Lower = higher ranking / shown first
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  pools        TournamentPool[]
  
  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([tournamentId, sortOrder])
}

// Delegated admin roles – organizer can grant co_organizer to other users
enum TournamentAdminRoleType {
  co_organizer
}

model TournamentAdminRole {
  id           String   @id @default(uuid())
  
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User     @relation("TournamentAdminRoles", fields: [userId], references: [id], onDelete: Cascade)
  
  role         TournamentAdminRoleType @default(co_organizer)
  
  grantedById  String
  grantedBy    User     @relation("TournamentAdminRolesGranted", fields: [grantedById], references: [id])
  
  createdAt    DateTime @default(now())
  
  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

// Tournament team invitations - captains can invite players to join their team
enum InvitationStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

model TournamentTeamInvitation {
  id        String   @id @default(uuid())
  
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  // Email of the person being invited (they may or may not have an account)
  inviteeEmail String
  inviteeName  String?  // Optional: name of the invitee
  
  // If the invitee has an account, link to their user
  inviteeUserId String?
  inviteeUser   User?    @relation("TeamInvitations", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  
  // Who sent the invitation
  inviterId String
  inviter   User     @relation("SentTeamInvitations", fields: [inviterId], references: [id])
  
  // Unique invitation token for secure acceptance
  inviteToken String   @unique
  
  status      InvitationStatus @default(pending)
  
  // Message from the inviter
  message     String?
  
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([teamId])
  @@index([inviteeEmail])
  @@index([inviteeUserId])
  @@index([inviteToken])
  @@index([status])
  @@index([expiresAt])
  @@index([teamId, inviteeEmail, status])
}

enum LeagueStatus {
  draft
  registration
  active
  completed
  cancelled
}

model League {
  id          String       @id @default(uuid())
  title       String
  description String?
  sport       SportType
  location    String?
  latitude    Float?
  longitude   Float?
  locationName String?
  city        String?
  country     String?
  startDate   DateTime
  endDate     DateTime?
  sessionCount Int?
  status      LeagueStatus @default(draft)
  isPublic    Boolean      @default(false)
  isPremium   Boolean      @default(true)
  maxTeams    Int?
  
  creatorId   String
  creator     User         @relation("LeagueOrganizer", fields: [creatorId], references: [id])
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  teams       LeagueTeam[]
  sessions    LeagueSessionEntry[]
  standings   LeagueStanding[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([groupId])
  @@index([creatorId])
  @@index([status])
  @@index([sport])
}

model LeagueTeam {
  id            String   @id @default(uuid())
  name          String
  leagueId      String
  league        League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  captainUserId String?
  captain       User?    @relation("LeagueTeamCaptain", fields: [captainUserId], references: [id], onDelete: SetNull)
  players       LeaguePlayer[]
  homeMatches   LeagueMatch[] @relation("LeagueHomeTeam")
  awayMatches   LeagueMatch[] @relation("LeagueAwayTeam")
  standings     LeagueStanding[]
  createdAt     DateTime @default(now())
  
  @@unique([leagueId, name])
  @@index([leagueId])
}

model LeaguePlayer {
  id           String     @id @default(uuid())
  teamId       String
  team         LeagueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation("LeaguePlayer", fields: [userId], references: [id], onDelete: SetNull)
  playerName   String?
  jerseyNumber Int?
  createdAt    DateTime   @default(now())
  
  @@unique([teamId, userId])
  @@index([teamId])
}

model LeagueSessionEntry {
  id          String   @id @default(uuid())
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  sessionId   String
  session     Session  @relation("LeagueSessions", fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber Int?
  createdAt   DateTime @default(now())
  
  @@unique([leagueId, sessionId])
  @@index([leagueId])
}

model LeagueMatch {
  id          String     @id @default(uuid())
  leagueId    String
  roundNumber Int?
  homeTeamId  String
  homeTeam    LeagueTeam @relation("LeagueHomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId  String
  awayTeam    LeagueTeam @relation("LeagueAwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore   Int?
  awayScore   Int?
  status      String     @default("scheduled")
  scheduledAt DateTime?
  playedAt    DateTime?
  createdAt   DateTime   @default(now())
  
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model LeagueStanding {
  id           String     @id @default(uuid())
  leagueId     String
  league       League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId       String
  team         LeagueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int        @default(0)
  won          Int        @default(0)
  drawn        Int        @default(0)
  lost         Int        @default(0)
  goalsFor     Int        @default(0)
  goalsAgainst Int        @default(0)
  points       Int        @default(0)
  updatedAt    DateTime   @updatedAt
  
  @@unique([leagueId, teamId])
  @@index([leagueId])
}
