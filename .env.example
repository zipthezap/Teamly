# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamly?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
# Separate secret for refresh tokens (recommended to be different from JWT_SECRET)
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
# JWT token expiration in days (default: 7)
JWT_EXPIRY_DAYS=7

# Security Configuration
# Account lockout after failed login attempts (default: 5)
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
# Account lockout duration in minutes (default: 15)
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
# Password reset token expiry in hours (default: 1)
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# Email Configuration
# Options: 'sendgrid', 'ses', or leave blank for SMTP
EMAIL_SERVICE=
# SendGrid
SENDGRID_API_KEY=
# AWS SES
AWS_SES_HOST=
AWS_SES_USER=
AWS_SES_PASSWORD=
# Generic SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@teamly.app

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3001

# Google API Key (for Maps and Geocoding)
# Used for address search and map display in the frontend
# Get your API key from: https://console.cloud.google.com/apis/credentials
# SECURITY WARNING: Never commit your actual API key to version control!
# Replace this placeholder with your own key in your local .env file
GOOGLE_API_KEY=your-google-api-key-here