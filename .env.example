# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamly?schema=public"

# Redis Configuration (optional, for distributed caching and rate limiting)
# If not set, the application will use in-memory caching and rate limiting
# Format: redis://[[username]:[password]@][host][:port][/database]
# Examples:
#   redis://localhost:6379
#   redis://:password@localhost:6379
#   redis://username:password@redis.example.com:6379/0
REDIS_URL=
# Redis connection timeout in milliseconds (default: 5000)
REDIS_CONNECT_TIMEOUT_MS=5000

# Database Connection Pool Configuration
# Maximum number of connections in the pool (default: 20)
DB_POOL_MAX=20
# Minimum number of connections in the pool (default: 2)
DB_POOL_MIN=2
# Maximum time (ms) a connection can remain idle (default: 30000)
DB_IDLE_TIMEOUT_MS=30000
# Maximum time (ms) to wait for a connection (default: 5000)
DB_CONNECTION_TIMEOUT_MS=5000
# Maximum lifetime (seconds) of a connection (default: 1800)
DB_MAX_LIFETIME_SECONDS=1800
# Query timeout (ms) - how long a query can run (default: 30000)
DB_QUERY_TIMEOUT_MS=30000
# Statement timeout (ms) - server-side timeout (default: 30000)
DB_STATEMENT_TIMEOUT_MS=30000

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
# Separate secret for refresh tokens (recommended to be different from JWT_SECRET)
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
# JWT token expiration in days (default: 7)
JWT_EXPIRY_DAYS=7

# Security Configuration
# Account lockout after failed login attempts (default: 5)
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
# Account lockout duration in minutes (default: 15)
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
# Password reset token expiry in hours (default: 1)
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# Transaction Configuration
# Maximum time to wait for a transaction lock in milliseconds (default: 5000)
TRANSACTION_MAX_WAIT_MS=5000
# Transaction timeout in milliseconds (default: 10000)
TRANSACTION_TIMEOUT_MS=10000

# Email Retry Configuration
# Base delay between email retries in milliseconds (default: 300000 = 5 minutes)
EMAIL_RETRY_BASE_DELAY_MS=300000
# Exponential backoff multiplier (default: 2, retries: 5min, 10min, 20min)
EMAIL_RETRY_BACKOFF_MULTIPLIER=2

# Email Configuration
# Options: 'sendgrid', 'ses', or leave blank for SMTP
EMAIL_SERVICE=
# SendGrid
SENDGRID_API_KEY=
# AWS SES
AWS_SES_HOST=
AWS_SES_USER=
AWS_SES_PASSWORD=
# Generic SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@teamly.app

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3001

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id-here
FACEBOOK_APP_SECRET=your-facebook-app-secret-here
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Google API Key (for Maps and Geocoding)
# Used for address search and map display in the frontend
# Get your API key from: https://console.cloud.google.com/apis/credentials
# SECURITY WARNING: Never commit your actual API key to version control!
# Replace this placeholder with your own key in your local .env file
# Note: The frontend also requires VITE_GOOGLE_MAPS_API_KEY to be set in src/frontend/.env
GOOGLE_API_KEY=your-google-api-key-here

# File Upload Configuration
# Maximum file upload size in MB (default: 5)
MAX_FILE_UPLOAD_SIZE_MB=5
# Upload directory (default: uploads)
UPLOAD_DIR=uploads

# Health Check Configuration
# Database response time threshold (ms) for degraded status (default: 1000)
HEALTH_CHECK_DB_SLOW_MS=1000
# Memory usage percentage threshold for degraded status (default: 90)
HEALTH_CHECK_MEMORY_THRESHOLD=90