# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamly?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-this-in-production

# Email Configuration
# Options: 'sendgrid', 'ses', or leave blank for SMTP
EMAIL_SERVICE=
# SendGrid
SENDGRID_API_KEY=
# AWS SES
AWS_SES_HOST=
AWS_SES_USER=
AWS_SES_PASSWORD=
# Generic SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@teamly.app

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3001
