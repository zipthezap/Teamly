FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm install


# Copy backend source files
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY src/backend ./src/backend
# Copy shared types for backend imports
COPY src/shared ./src/shared
# Copy tsconfig.json for TypeScript build
COPY tsconfig.json ./


# Generate Prisma Client (uses already installed prisma)
RUN npm run prisma:generate

# Build backend TypeScript
RUN npm run build

# Create uploads directories
RUN mkdir -p /app/uploads/profiles /app/uploads/groups /app/uploads/temp

# Expose ports (3000 for HTTP/default, 3443 for HTTPS if configured)
EXPOSE 3000 3443

# Start the application
CMD ["npm", "start"]
