@startuml
title Teamly Prisma Schema

hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "Enums" {
  enum EventNotificationType {
    join
    leave
    late
    confirmed
    declined
    status_change
    comment
    event_updated
    event_cancelled
  }

  enum GroupNotificationType {
    accepted
    invited
    join_request
    event_created
    nearby_created
    removed
  }

  enum TeamUpNotificationType {
    teamup_response
    teamup_accepted
    teamup_declined
    teamup_nearby
    teamup_comment
  }

  enum TournamentNotificationType {
    team_registered
    tournament_updated
    tournament_cancelled
    match_scheduled
    score_submitted
  }

  enum EventParticipantStatus {
    pending
    confirmed
    declined
  }

  enum GuestParticipantStatus {
    confirmed
    declined
  }

  enum GroupJoinRequestSource {
    USER
    INVITE
    LINK
  }

  enum GroupJoinRequestStatus {
    pending
    approved
    rejected
  }

  enum GroupMemberRole {
    member
    moderator
    admin
  }

  enum EventAttendanceStatus {
    on_time
    late
  }

  enum EventStatus {
    upcoming
    ongoing
    completed
    cancelled
  }

  enum SportType {
    football
    basketball
    tennis
    volleyball
    running
    cycling
    swimming
    cricket
    americanFootball
    iceHockey
    baseball
    rugby
    handball
    fieldHockey
    other
  }

  enum EventRequestStatus {
    voting
    finalized
    cancelled
    expired
  }

  enum EmailQueueStatus {
    pending
    sent
    failed
    retry
  }

  enum TeamUpRequestStatus {
    open
    filled
    cancelled
    expired
  }

  enum TeamUpResponseStatus {
    pending
    accepted
    declined
  }

  enum TournamentFormat {
    single_elimination
    double_elimination
    round_robin
    groups_knockout
  }

  enum TournamentStatus {
    draft
    registration
    in_progress
    completed
    cancelled
  }

  enum MatchStatus {
    scheduled
    in_progress
    completed
    cancelled
  }

  enum BracketStage {
    group_stage
    round_of_32
    round_of_16
    quarter_finals
    semi_finals
    third_place
    finals
  }

  enum InvitationStatus {
    pending
    accepted
    declined
    expired
    cancelled
  }
}

package "Core" {
  class User {
    +id: String
    +email: String
    +password: String?
    +name: String
    +createdAt: DateTime
    +updatedAt: DateTime
    +googleId: String?
    +facebookId: String?
    +authProvider: String?
    +oauthProfilePicture: String?
    +lastOAuthSync: DateTime?
    +twoFactorEnabled: Boolean
    +twoFactorSecret: String?
    +twoFactorBackupCodes: String[]
    +emailNotifications: Boolean
    +emailVerified: Boolean
    +emailVerificationToken: String?
    +passwordResetToken: String?
    +passwordResetExpires: DateTime?
    +failedLoginAttempts: Int
    +accountLockedUntil: DateTime?
    +city: String?
    +country: String?
    +address: String?
    +postalCode: String?
    +discoveryRadius: Int?
    +profilePicture: String?
    +deletedAt: DateTime?
    +createdBy: String?
    +updatedBy: String?
  }

  class UserProfilePicture {
    +id: String
    +userId: String
    +url: String
    +createdAt: DateTime
    +isCurrent: Boolean
    +deletedAt: DateTime?
    +createdBy: String?
    +updatedBy: String?
    +updatedAt: DateTime
  }

  class Group {
    +id: String
    +name: String
    +description: String?
    +createdAt: DateTime
    +updatedAt: DateTime
    +isPublic: Boolean
    +latitude: Float?
    +longitude: Float?
    +locationName: String?
    +city: String?
    +country: String?
    +picture: String?
    +sportType: SportType?
    +maxMembers: Int?
    +autoApproveJoinRequests: Boolean
    +tags: String?
    +allowMemberInvites: Boolean
    +allowMemberCopyLink: Boolean
    +inviteToken: String?
    +inviteTokenExpiresAt: DateTime?
    +creatorId: String
  }

  class GroupJoinRequest {
    +id: String
    +groupId: String
    +userId: String
    +status: GroupJoinRequestStatus
    +createdAt: DateTime
    +createdBy: GroupJoinRequestSource
    +expiresAt: DateTime?
    +invitedBy: String?
  }

  class GroupMember {
    +id: String
    +role: GroupMemberRole
    +joinedAt: DateTime
    +userId: String
    +groupId: String
  }

  class GroupMessage {
    +id: String
    +content: String
    +createdAt: DateTime
    +userId: String
    +groupId: String
  }
}

package "Events" {
  class Event {
    +id: String
