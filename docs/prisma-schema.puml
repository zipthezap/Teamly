    +userId: String
  }

  class GuestParticipant {
    +id: String
    +name: String
    +status: GuestParticipantStatus
    +joinedAt: DateTime
    +eventId: String
  }

  class Comment {
    +id: String
    +content: String
    +createdAt: DateTime
    +updatedAt: DateTime
    +eventId: String
    +userId: String
    +parentId: String?
  }

  class CommentMention {
    +id: String
    +commentId: String
    +userId: String
    +createdAt: DateTime
  }
}

package "Notifications" {
  class GroupNotification {
    +id: String
