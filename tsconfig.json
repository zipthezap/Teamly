{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    // Strict mode gradually enabled
    "strict": false,
    "noImplicitAny": true, // Now enabled - all any types have been fixed
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": false, // TODO: Enable after fixing all missing return statements
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/backend/**/*", "scripts/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "src/frontend", "src/app", "dist", "src/backend/__tests__"]
}
