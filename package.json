{
  "name": "teamly",
  "version": "1.0.0",
  "description": "A sports event organization app that allows individuals to set and organize small sports matches",
  "main": "dist/backend/server.js",
  "scripts": {
    "build": "tsc",
    "mobile:desktop:init": "cd src/mobile && flutter config --enable-windows-desktop && flutter create --platforms=windows .",
    "mobile:desktop": "cd src/mobile && flutter run -d windows --dart-define=APP_ENV=dev --dart-define=API_BASE_URL=http://localhost:3000/api",
    "start": "node dist/backend/server.js",
    "dev": "nodemon --exec ts-node src/backend/server.ts",
    "auth-service:dev": "nodemon --exec ts-node src/backend/auth-service/server.ts",
    "tournament-service:dev": "nodemon --exec ts-node src/backend/tournament-service/server.ts",
    "community-service:dev": "nodemon --exec ts-node src/backend/community-service/server.ts",
    "notification-service:dev": "nodemon --exec ts-node src/backend/notification-service/server.ts",
    "auth-service:start": "node dist/backend/auth-service/server.js",
    "tournament-service:start": "node dist/backend/tournament-service/server.js",
    "community-service:start": "node dist/backend/community-service/server.js",
    "notification-service:start": "node dist/backend/notification-service/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "teamup:backfill-positions": "ts-node src/backend/scripts/backfillTeamUpPositions.ts",
    "tournaments:backfill-lifecycle-statuses": "ts-node src/backend/scripts/backfillTournamentLifecycleStatuses.ts",
    "tournaments:seed-lifecycle-scenarios": "ts-node src/backend/scripts/seedTournamentLifecycleScenarios.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "ngrok http 8080",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop teamly-api",
    "pm2:restart": "pm2 restart teamly-api",
    "pm2:reload": "pm2 reload teamly-api",
    "pm2:logs": "pm2 logs teamly-api",
    "pm2:monit": "pm2 monit",
    "lint": "eslint src/backend --ext .ts",
    "lint:fix": "eslint src/backend --ext .ts --fix",
    "test:ci": "vitest run --coverage"
  },
  "keywords": [
    "sports",
    "events",
    "organization",
    "team"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.3",
    "redis": "^4.7.0",
    "rrule": "^2.8.1",
    "sharp": "^0.33.5",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/redis": "^4.0.10",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^3.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
