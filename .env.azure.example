# Azure Deployment Environment Variables Template
# Copy this to .env.azure and fill in your actual values

# =============================================================================
# Azure Resource Configuration
# =============================================================================
AZURE_RESOURCE_GROUP=teamly-rg
AZURE_LOCATION=eastus
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Azure Container Registry
AZURE_REGISTRY_NAME=teamlyregistry1234567890
AZURE_REGISTRY_USERNAME=teamlyregistry1234567890
AZURE_REGISTRY_PASSWORD=your-acr-password-here

# Azure App Services
AZURE_BACKEND_WEBAPP_NAME=teamly-backend
AZURE_FRONTEND_WEBAPP_NAME=teamly-frontend

# =============================================================================
# Database Configuration (Azure Database for PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://teamlyadmin:YourPassword123!@teamly-db.postgres.database.azure.com:5432/teamly?schema=public&sslmode=require
POSTGRES_USER=teamlyadmin
POSTGRES_PASSWORD=YourPassword123!
POSTGRES_SERVER=teamly-db.postgres.database.azure.com
POSTGRES_DB=teamly

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_URL=redis://:your-redis-key@teamly-redis.redis.cache.windows.net:6379
REDIS_HOST=teamly-redis.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-primary-key

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=production
PORT=8080

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your-generated-jwt-secret-here-use-openssl-rand

# Frontend and Backend URLs
FRONTEND_URL=https://teamly-frontend.azurewebsites.net
BACKEND_URL=https://teamly-backend.azurewebsites.net
VITE_API_URL=https://teamly-backend.azurewebsites.net/api

# =============================================================================
# OAuth Configuration (Optional)
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://teamly-backend.azurewebsites.net/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://teamly-backend.azurewebsites.net/api/auth/facebook/callback

# =============================================================================
# Email Configuration (Optional)
# =============================================================================
# SMTP Settings for sending emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=Teamly <noreply@teamly.app>

# =============================================================================
# Security Configuration
# =============================================================================
# CORS Origins (comma-separated)
CORS_ORIGINS=https://teamly-frontend.azurewebsites.net,https://your-custom-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=another-random-secret-for-sessions

# =============================================================================
# Monitoring and Logging (Optional)
# =============================================================================
# Application Insights (if using Azure Application Insights)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_REDIS_CACHE=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_OAUTH=true

# =============================================================================
# Google Maps API (Optional)
# =============================================================================
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# Storage Configuration
# =============================================================================
# Upload limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# =============================================================================
# GitHub Actions Secrets
# =============================================================================
# Add these as secrets in your GitHub repository:
# - AZURE_CREDENTIALS (JSON output from: az ad sp create-for-rbac)
# - AZURE_REGISTRY_NAME
# - AZURE_REGISTRY_USERNAME
# - AZURE_REGISTRY_PASSWORD
# - AZURE_BACKEND_WEBAPP_NAME
# - AZURE_FRONTEND_WEBAPP_NAME
# - AZURE_RESOURCE_GROUP

# Example AZURE_CREDENTIALS format:
# {
#   "clientId": "your-client-id",
#   "clientSecret": "your-client-secret",
#   "subscriptionId": "your-subscription-id",
#   "tenantId": "your-tenant-id"
# }
